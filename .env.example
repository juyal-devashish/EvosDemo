# Variable names only. Never commit values.

# ── Next.js app: .env.local (local) and Vercel project settings (deployed) ──
CONVEX_DEPLOYMENT=                    # written by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=               # public by design: the browser talks to Convex directly
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=    # public by design
CLERK_SECRET_KEY=                     # secret: never prefix with NEXT_PUBLIC_
NEXT_PUBLIC_SENTRY_DSN=               # public by design

# ── Convex functions: `npx convex env set NAME value` (add --prod for production) ──
# ANTHROPIC_API_KEY=                  # model calls; server-side only
# CLERK_JWT_ISSUER_DOMAIN=            # Issuer URL of the Clerk "convex" JWT template (adds the role claim)
# SENTRY_DSN=                         # forwards permission.demoted, action.refused, suite.incomplete

# ── Playwright signed-in tests (.env.local only) ──
E2E_QA_EMAIL=
E2E_QA_PASSWORD=
E2E_PLANNER_EMAIL=
E2E_PLANNER_PASSWORD=
